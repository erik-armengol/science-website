---
import { publications } from '../data/publications';
import '../styles/global.css';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const description = 'Erik Armengol — researcher in quantum machine learning, efficient models, and research software. Publications, background, and contact.';
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f8f7f3" />
    <meta property="og:title" content="Erik Armengol · Research & machine learning" />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="canonical" href={new URL(import.meta.env.BASE_URL, Astro.site)} />
    <link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
    <title>Erik Armengol · Research & machine learning</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header wrap">
      <a class="wordmark" aria-label="Erik Armengol home">Erik Armengol</a>
      <nav aria-label="Main navigation"><a href="#research">Research</a><a href="#about">About</a><a href="mailto:erik@armengol.me">Get in touch <span aria-hidden="true">↗</span></a></nav>
    </header>
    <main id="main" class="wrap">
      <section class="hero" aria-labelledby="intro-title">
        <div class="hero-copy">
          <p class="eyebrow">Research scientist · Quantum & Classical Machine Learning</p>
          
          <!-- <h1 id="intro-title">Understanding deeply.<br /><em>Building from first principles.</em></h1> -->
          <!-- <h1 id="intro-title">Building from first principles.<br /></h1> -->
          <h1 id="intro-title">Thinking from first principles.<br /><em>Learning from experiments.</em></h1>
          
          <p class="intro">I’m Erik, a researcher working at the intersection of machine learning and quantum computing. I study how learning models work, where their limits lie, and how quantum computers could surpass the capabilities of the AI models we currently have. My true passion is understanding from the ground up, so acting from first principles is in my DNA.</p>
          <p class="status"><span aria-hidden="true"></span> Writing my PhD thesis at ICFO · Expected completion before summer 2027</p>
          <div class="hero-links"><a class="primary-link" href="#research">Explore my research <span aria-hidden="true">↓</span></a>
            <!-- <a href="https://scholar.google.com/citations?user=Anmn1JoAAAAJ">Google Scholar <span aria-hidden="true">↗</span></a> -->
          </div>
        </div>
        <div class="research-art" aria-hidden="true">
          <img src=`${base}/atom.svg` alt="Research illustration" width="360" height="360"/>
          <!-- <span>Learning, through a different lens.</span> -->
        </div>
      </section>
      <section id="research" class="research section" aria-labelledby="research-title">
        <div class="section-heading"><div><p class="eyebrow">01 / Research</p><h2 id="research-title">Publications & preprints</h2><a class="text-link" href="https://scholar.google.com/citations?user=Anmn1JoAAAAJ&hl=en">More on my Google Scholar<span aria-hidden="true">↗</span></a></div><p>Learning theory, efficient inference,<br />and scalable generative models.</p></div>
        <div class="research-toolbar"><div class="filters" role="group" aria-label="Filter publications"><button class="active" data-filter="All" aria-pressed="true">All work <span>06</span></button><button data-filter="Journal" aria-pressed="false">Journal articles</button><button data-filter="Preprint" aria-pressed="false">Preprints</button></div><span id="result-count" class="result-count" aria-live="polite">6 papers</span></div>
        <div class="papers">{publications.map((paper, i) => <article class="paper" data-type={paper.type}>
          <div class="paper-index">{String(i + 1).padStart(2, '0')}<span>{paper.year}</span></div>
          <div class="paper-content"><div class="paper-meta"><span class:list={['badge', { preprint: paper.type === 'Preprint' }]}>{paper.type === 'Journal' ? 'Journal article' : 'Preprint'}</span><span>{paper.topic}</span></div><h3><a href={paper.url}>{paper.title}</a></h3><p class="authors">{paper.authors}</p><p class="paper-summary">{paper.summary}</p><p class="venue">{paper.venue} · {paper.year}</p></div>
          <!-- <div class="paper-links"><a href={paper.url} aria-label={`Read ${paper.title}`}>Paper <span aria-hidden="true">↗</span></a><a href={paper.pdf} aria-label={`PDF of ${paper.title}`}>PDF <span aria-hidden="true">↗</span></a></div> -->
          <div class="paper-links"><a href={paper.pdf} aria-label={`PDF of ${paper.title}`}>PDF <span aria-hidden="true">↗</span></a></div>
        </article>)}</div>
        <p class="research-note">You may also find my work published under Erik Recio-Armengol.</p>
      </section>
      <section id="about" class="about section" aria-labelledby="about-title">
        <div><p class="eyebrow">02 / Background</p><h2 id="about-title">Driven by curiosity.<br /><em>Grounded by rigor.</em></h2><a class="text-link" href="https://www.linkedin.com/in/erik-armengol">More on LinkedIn <span aria-hidden="true">↗</span></a></div>
        <div class="about-copy"><p>I’m finishing my PhD in Quantum Machine Learning at ICFO. My work combines mathematical analysis and numerical experiments to understand learning in high-dimensional systems, with a focus on model design, efficient inference, and optimization.</p><p>I enjoy getting to the foundations of a problem: understanding why a method works, identifying its limits, and turning that understanding into useful software. Python, JAX, and PyTorch are central to my day-to-day work.</p><p>My experience spans academic research and industry, including research stays and internships at Freie Universität Berlin, Xanadu, Los Alamos National Laboratory, and Allos AI. Before research, I spent several years building software and data analysis tools.</p><p>I’m interested in Research Scientist roles where I can bring this mix of theory and implementation to fundamental questions in AI.</p>
          <!-- <div class="skills" aria-label="Research tools and interests"><span>Python</span><span>JAX</span><span>PyTorch</span><span>Machine Learning</span><span>Generative models</span></div> -->
        </div>
      </section>
      <section class="contact section" aria-labelledby="contact-title"><p class="eyebrow">03 / Say hello</p><h2 id="contact-title">Let’s work on interesting problems.</h2><p>Research collaborations, ideas, or opportunities in machine learning and quantum computing.</p><a class="contact-email" href="mailto:erik@armengol.me">erik@armengol.me <span aria-hidden="true">↗</span></a></section>
    </main>
    <footer class="wrap"><span>© {new Date().getFullYear()} Erik Armengol</span><div><a href="https://github.com/erik-armengol">GitHub ↗</a><a href="https://scholar.google.com/citations?user=Anmn1JoAAAAJ">Scholar ↗</a><a href="https://www.linkedin.com/in/erik-armengol">LinkedIn ↗</a></div><a href="#">Back to top ↑</a></footer>
    <script>
      const buttons = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
      const papers = document.querySelectorAll<HTMLElement>('.paper');
      buttons.forEach(button => button.addEventListener('click', () => {
        buttons.forEach(other => { const active = other === button; other.classList.toggle('active', active); other.setAttribute('aria-pressed', String(active)); });
        let count = 0;
        papers.forEach(paper => { paper.hidden = button.dataset.filter !== 'All' && paper.dataset.type !== button.dataset.filter; if (!paper.hidden) count++; });
        const counter = document.querySelector('#result-count');
        if (counter) counter.textContent = `${count} papers`;
      }));
    </script>
  </body>
</html>

<style>
  #research-title {
    margin-bottom: 27px;
  }

  .hero-copy > .eyebrow {
    font-size: 12px;
  }

  @media (max-width: 640px) {
    .hero-copy > .eyebrow {
      font-size: 11px;
    }
  }
</style>
